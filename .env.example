# ---- Database (used by docker-compose for both postgres and backend) ----
POSTGRES_DB=unimail
POSTGRES_USER=unimail
POSTGRES_PASSWORD=change-me-strong-password

# ---- App auth ----
# Any long random string
JWT_SECRET=change-me-long-random-string
JWT_EXPIRE_HOURS=24

# ---- Token encryption at rest ----
# Generate with:  python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ---- URLs ----
# Where the browser reaches the frontend (used for CORS + OAuth redirects back to the app)
FRONTEND_ORIGIN=http://localhost:5173
# Public URL of the backend (used to build OAuth redirect URIs; must match the
# redirect URI registered with Google/Microsoft)
BACKEND_URL=http://localhost:8000

# ---- OAuth: Gmail (Google Cloud Console -> APIs & Services -> Credentials) ----
# Redirect URI to register:  <BACKEND_URL>/api/accounts/oauth/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- OAuth: Outlook (Azure Portal -> App registrations) ----
# Redirect URI to register:  <BACKEND_URL>/api/accounts/oauth/outlook/callback
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# ---- Background sync ----
SYNC_INTERVAL_MINUTES=5

# Attachment storage (MinIO / any S3-compatible endpoint; empty = disabled, IMAP fallback)
MINIO_ROOT_USER=unimail
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://minio:9000
S3_BUCKET=unimail-attachments
S3_ACCESS_KEY=unimail
S3_SECRET_KEY=
